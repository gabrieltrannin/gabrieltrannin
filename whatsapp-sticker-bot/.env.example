# Copie este arquivo para ".env" e mude o que quiser.
# Tudo aqui é opcional: sem o .env o bot usa os valores padrão.

# Prefixo dos comandos (ex.: "!" -> !s, "/" -> /s)
PREFIX=!

# Nome do pacote e autor que aparecem ao tocar na figurinha
PACK_NAME=Figurinhas
PACK_AUTHOR=Sticker Bot

# No privado, qualquer foto/vídeo/GIF vira figurinha sem precisar de comando (true/false)
AUTO_STICKER_PRIVATE=true

# Duração máxima das figurinhas animadas, em segundos
MAX_VIDEO_SECONDS=10

# Tamanho máximo do arquivo recebido, em MB
MAX_MEDIA_MB=30

# Para conectar com código de 8 dígitos em vez de QR Code, coloque o número
# do bot com DDI + DDD, só números. Ex.: 5541999998888
PHONE_NUMBER=

# Quantas conversões rodam ao mesmo tempo
MAX_CONCURRENT=2

# Nível de log da biblioteca do WhatsApp (silent, error, warn, info, debug)
LOG_LEVEL=silent
